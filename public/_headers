# Served by Cloudflare Static Assets. Kept out of index.html on purpose: Vite's
# React plugin injects an inline preamble in development, which a strict
# script-src would block, and this file only applies to the built output.
#
# The comment syntax here is a hash and nothing else. Workers parses this file on
# deploy and has no block comment, so a /* would be read as a URL pattern that
# matches nothing and every line after it as a malformed header.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable
